# Copy to .env.local and fill in. Never commit .env.local.
# Neon pooled connection string (dev branch locally, main branch on Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Random 32+ char secret used to sign admin session cookies (different per environment)
AUTH_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(36).toString('base64url'))\""
# Admin login email
ADMIN_EMAIL="you@example.com"
# First admin password — read ONLY by `npm run db:seed`. Remove after seeding.
ADMIN_PASSWORD=""
# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
